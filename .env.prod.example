# ==========================================================
# SUA BARBEARIA - FRONTEND - Producao (modelo)
#
# Na VM:  cp .env.prod.example .env   e ajuste a API_BASE_URL.
# NUNCA comite o .env preenchido.
#
# ATENCAO: estas variaveis sao lidas pelo DOCKER COMPOSE e viram build args da
# imagem -- nao sao lidas em tempo de execucao pelo app. O Flutter Web e um
# build estatico: mudar qualquer coisa aqui exige
# `docker compose -f docker-compose.yml -f docker-compose.prod.yml up --build -d`.
# ==========================================================

# --- URL da API ---
# Em producao o app e a API respondem no MESMO dominio: o nginx do backend
# serve este app na raiz e roteia /api/, /admin/, /health/, /static/ e /media/
# para o Django. Por isso aqui vai o dominio publico, sem sufixo -- o proprio
# app acrescenta /api/v1.
#
# Precisa bater com o DOMAIN do .env do backend.
API_BASE_URL=https://clmlabs.com.br

# --- Logs de rede no console do navegador ---
# Deixe `true` enquanto valida o ambiente; depois volte para `false`.
ENABLE_NETWORK_LOGS=false

# --- Entrar com o Google ---
# Client ID "Aplicativo da Web" de PRODUCAO. Em "Origens JavaScript
# autorizadas" cadastre o dominio publico (ex.: https://clmlabs.com.br).
#
# O MESMO valor vai em GOOGLE_OAUTH_CLIENT_IDS no .env do backend.
GOOGLE_WEB_CLIENT_ID=

# --- Service worker (PWA) ---
# `none` continua sendo o mais previsivel: com o service worker ativo o
# navegador serve o build antigo depois de um deploy, e o usuario nao tem como
# forcar a atualizacao. O cache-busting por `<base href="/v/<hash>/">` ja
# resolve o problema de versao sem os efeitos colaterais do PWA.
PWA_STRATEGY=none

# --- Versao do SDK do Flutter ---
# Fixe uma versao (ex.: 3.47.2) para que o build da VM seja reproduzivel.
# `stable` muda sozinho e pode quebrar um deploy sem nenhuma alteracao de
# codigo da sua parte.
FLUTTER_VERSION=stable

# --- Nao usado em producao ---
# A porta nao e publicada: quem atende a internet e o nginx do backend.
# O docker-compose.prod.yml zera a publicacao com `ports: !reset []`.
#WEB_PORT=8080

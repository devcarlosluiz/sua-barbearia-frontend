# ==========================================================
# SUA BARBEARIA - FRONTEND - Environment variables (example)
# Copy to .env and adjust. NEVER commit the real .env file.
#
# ATENCAO: estas variaveis sao lidas pelo DOCKER COMPOSE e viram build args da
# imagem -- nao sao lidas em tempo de execucao pelo app. O Flutter Web e um
# build estatico: mudar o .env exige `docker compose up --build -d`.
#
# As variaveis do Django ficam no repositorio sua-barbearia-backend.
# ==========================================================

# --- Porta em que o app e publicado no host ---
# 8080 e a porta que o CORS_ALLOWED_ORIGINS do backend ja libera. Ao trocar
# aqui, acrescente a nova origem no .env do backend e reinicie-o.
WEB_PORT=8080

# --- URL da API ---
# Vazio (recomendado em desenvolvimento): o app descobre o backend a partir do
# endereco da propria pagina -- mesmo host, porta 8000. Assim um unico build
# funciona em http://localhost:8080, no navegador do emulador Android
# (http://10.0.2.2:8080) e em outro aparelho da rede local.
#
# Preencha apenas para apontar para outro ambiente:
#   API_BASE_URL=https://api.suabarbearia.com.br
API_BASE_URL=

# --- Logs de rede no console do navegador ---
# Uteis para diagnosticar chamadas em um build de release.
ENABLE_NETWORK_LOGS=false

# --- Service worker (PWA) ---
# `none` em desenvolvimento: com o service worker ativo o navegador serve o
# build antigo mesmo depois de recompilar, e nem Ctrl+Shift+R resolve.
# Em producao de verdade, use `offline-first`.
PWA_STRATEGY=none

# --- Versao do SDK do Flutter usada nas imagens ---
# `stable` acompanha o canal. Fixe uma versao (ex.: 3.47.2) para builds
# reproduziveis.
FLUTTER_VERSION=stable

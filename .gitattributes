# Normaliza fim de linha por tipo de arquivo.
#
# Sem isto, com `core.autocrlf=true` no Windows (o padrão do Git for Windows) a
# árvore de trabalho local fica com CRLF. O `docker build` local passa a ler um
# Dockerfile com CRLF, e o `gradlew` (shell script) quebraria num build Linux
# com `$'\r': command not found`.
* text=auto

# Sempre LF: são lidos por Linux (imagem Docker, CI, Gradle)
Dockerfile      text eol=lf
*.dart          text eol=lf
*.sh            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.conf          text eol=lf
*.gradle        text eol=lf
*.kts           text eol=lf
*.properties    text eol=lf
*.json          text eol=lf
*.html          text eol=lf
*.md            text eol=lf
gradlew         text eol=lf
.env.example    text eol=lf
.dockerignore   text eol=lf
.gitignore      text eol=lf

# Sempre CRLF: rodam no Windows
*.ps1           text eol=crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Xcode / iOS
*.pbxproj       text eol=lf
*.plist         text eol=lf

# Binários
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.otf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.jar binary
*.keystore binary
*.jks binary
